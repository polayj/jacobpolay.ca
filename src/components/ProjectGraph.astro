---
import { buildGraph, layoutGraph, wrapLabel } from '../lib/graph';
import { loadGraphInput } from '../lib/projects-content';

interface Props {
  featured: string[];
  width: number;
  height: number;
  margin?: { x: number; y: number };
  class?: string;
}
const { featured, width: W, height: H, margin, class: extra = '' } = Astro.props;
const graph = buildGraph(await loadGraphInput());
const nodes = layoutGraph(graph, { width: W, height: H, margin });
const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
// Crop the frame to the space the layout actually uses, leaving room for labels above and below.
const top = Math.max(0, Math.min(...nodes.map((n) => n.y)) - 40);
const bottom = Math.min(H, Math.max(...nodes.map((n) => n.y)) + 50);
const kindName = { project: 'Project', publication: 'Publication', talk: 'Talk', person: 'Person', method: 'Method' } as const;
const isItem = (k: string) => k === 'project' || k === 'publication' || k === 'talk';
---
<svg class={`project-graph ${extra}`.trim()} viewBox={`0 ${top} ${W} ${bottom - top}`} role="group" aria-label="Graph of projects, writing, talks, collaborators and methods">
  <g class="edges">
    {graph.edges.map((e) => (
      <line x1={pos[e.source].x} y1={pos[e.source].y} x2={pos[e.target].x} y2={pos[e.target].y} data-a={e.source} data-b={e.target} />
    ))}
  </g>
  <g class="nodes">
    {nodes.map((n) => {
      const cls = `node kind-${n.kind}${featured.includes(n.id) ? ' featured' : ''}`;
      const lines = wrapLabel(n.label).length;
      const labelY = n.y < H - 50 ? n.y + 24 : n.y - 16 - (lines - 1) * 15;
      const r = n.kind === 'project' ? 10 : isItem(n.kind) ? 7 : 5;
      return isItem(n.kind) ? (
        <a class={cls} href={n.href} data-id={n.id} aria-label={`${n.label} (${kindName[n.kind].toLowerCase()})`}>
          <title>{`${kindName[n.kind]}: ${n.label}`}</title>
          <circle cx={n.x} cy={n.y} r={r} />
          <text x={n.x} y={labelY} text-anchor="middle">{wrapLabel(n.label).map((line, i, all) => <tspan x={n.x} dy={i === 0 ? 0 : 15}>{i < all.length - 1 ? `${line} ` : line}</tspan>)}</text>
        </a>
      ) : (
        <g class={cls} data-id={n.id}>
          <title>{`${kindName[n.kind]}: ${n.label}`}</title>
          <circle cx={n.x} cy={n.y} r={r} />
          <text x={n.x} y={labelY} text-anchor="middle">{wrapLabel(n.label).map((line, i, all) => <tspan x={n.x} dy={i === 0 ? 0 : 15}>{i < all.length - 1 ? `${line} ` : line}</tspan>)}</text>
        </g>
      );
    })}
  </g>
</svg>
